<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="800" height="600">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#151515;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0f0f0f;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="accent" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#D72638;stop-opacity:0.6" />
      <stop offset="100%" style="stop-color:#D72638;stop-opacity:0" />
    </linearGradient>
  </defs>
  <!-- Background -->
  <rect width="800" height="600" fill="url(#bg)"/>
  <!-- Top accent line -->
  <rect x="0" y="0" width="800" height="2" fill="url(#accent)"/>
  <!-- Corner mark -->
  <rect x="48" y="48" width="24" height="2" fill="#D72638" opacity="0.7"/>
  <rect x="48" y="48" width="2" height="24" fill="#D72638" opacity="0.7"/>
  <!-- Project label -->
  <text x="50%" y="42%" dominant-baseline="middle" text-anchor="middle"
        font-family="'Bebas Neue', Georgia, serif" font-size="52"
        fill="#F5F5F5" opacity="0.15" letter-spacing="4">IDENTITY VARIATIONS</text>
  <!-- Category -->
  <text x="50%" y="55%" dominant-baseline="middle" text-anchor="middle"
        font-family="Georgia, serif" font-size="11"
        fill="#D72638" opacity="0.6" letter-spacing="3">BRAND IDENTITY</text>
  <!-- TD watermark -->
  <text x="50%" y="68%" dominant-baseline="middle" text-anchor="middle"
        font-family="'Bebas Neue', Georgia, serif" font-size="18"
        fill="#F5F5F5" opacity="0.06" letter-spacing="8">TULSI DHAMELIYA</text>
  <!-- Border frame -->
  <rect x="1" y="1" width="798" height="598" fill="none" stroke="#ffffff" stroke-opacity="0.04" stroke-width="1"/>
</svg>
